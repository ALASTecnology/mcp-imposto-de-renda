{
  "name": "mcp-imposto-de-renda-monorepo",
  "version": "0.0.0",
  "private": true,
  "description": "MCP Imposto de Renda: servidor MCP local (stdio) para apoiar a declaração do IRPF.",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/ALASTecnology/mcp-imposto-de-renda#readme",
  "bugs": {
    "url": "https://github.com/ALASTecnology/mcp-imposto-de-renda/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ALASTecnology/mcp-imposto-de-renda.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "pnpm -r --parallel run typecheck",
    "test": "vitest run",
    "test:docs": "vitest run --config tools/docs/vitest.config.mts",
    "build": "pnpm -r run build",
    "docs:catalogo": "vitest run --config tools/docs/vitest.config.mts listar exemplos && node tools/docs/catalogo.mjs && node tools/docs/inserir.mjs && node tools/docs/referencia.mjs && vitest run --config tools/docs/vitest.config.mts markdown",
    "exemplos": "vitest run exemplos --mode gravar",
    "docs:links": "node tools/docs/links.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@types/node": "26.6.3",
    "@vitest/coverage-v8": "5.0.4",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vitest": "5.0.4"
  }
}
